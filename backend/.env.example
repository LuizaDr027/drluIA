# IA Provider: 'gemini' (padrão, gratuito) ou 'openai' (fallback)
AI_PROVIDER=gemini

# Google Generative AI (Gemini) - https://ai.google.dev/
GOOGLE_API_KEY=AIza...

# OpenAI (fallback)
OPENAI_API_KEY=sk-...

# Supabase (banco de dados + histórico)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Kiwify — token secreto do webhook (auto-cadastro de alunos na compra)
# Deixe vazio para testar sem validação de assinatura.
KIWIFY_WEBHOOK_SECRET=

# Hotmart — hottok do webhook (painel Hotmart > Ferramentas > Webhook)
# Obrigatório: sem ele, a rota /api/webhooks/hotmart rejeita tudo.
HOTMART_HOTTOK=

PORT=3001
